# ===================
# Cloudflare (Required for deployment)
# ===================
# Create API token at: Cloudflare Dashboard → My Profile → API Tokens
# Required permissions: Workers Scripts, KV Storage, D1, DNS (Edit), Zone (Read)
CLOUDFLARE_API_TOKEN=

# Find Zone ID at: Cloudflare Dashboard → your-domain → Overview (right sidebar)
CLOUDFLARE_ZONE_ID=

# ===================
# Alchemy (Required for deployment)
# ===================
# Encryption password for Alchemy state - generate with: openssl rand -base64 32
ALCHEMY_PASSWORD=your-secret-password-here

# ===================
# Email Service (Required for auth emails)
# ===================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# ===================
# OAuth Providers (Optional)
# ===================
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===================
# Bot Protection (Optional)
# ===================
# Cloudflare Turnstile: https://dash.cloudflare.com/turnstile
# Site key goes in packages/config/src/index.ts (public)
# Secret key goes here (server-side only)
TURNSTILE_SECRET_KEY=
