# Alchemy
# Encryption password for Alchemy secrets
# Generate a strong random password for production
ALCHEMY_PASSWORD=your-secret-password-here

# Resend (Email Service)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@template.zynth.dev

# Better Auth
# Generate a secure random string for production
# You can use: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Application
# Your application domain (used in emails and links)
APP_URL=http://localhost:5173

# OAuth Providers (optional)
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
