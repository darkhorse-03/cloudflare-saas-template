# ===================
# Required for Local Development
# ===================
# Encryption password for Alchemy state - can be any string for local dev
# For production, generate with: openssl rand -base64 32
ALCHEMY_PASSWORD=dev-password

# ===================
# Deployment (Optional - Alchemy uses browser OAuth by default)
# ===================
# Only set these if you prefer API token auth over browser OAuth
# Create API token at: Cloudflare Dashboard → My Profile → API Tokens → Create Token → Custom Token
# Required permissions (all Edit unless noted):
#   - Account: Workers Scripts, Workers KV Storage, D1, Workers R2 Storage
#   - Zone: DNS (Edit), Zone (Read)
# Tip: Start with "Edit Cloudflare Workers" template, then add D1, R2, DNS
# CLOUDFLARE_API_TOKEN=

# Find Zone ID at: Cloudflare Dashboard → your-domain → Overview (right sidebar)
# Only needed if deploying to custom domain
# CLOUDFLARE_ZONE_ID=

# @feature email
# ===================
# Email Service (Optional)
# ===================
# Without this: Auth works with email/password only (no verification emails, magic links)
# With this: Full email features (verification, magic link, password reset, welcome emails)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com
# @end email

# @feature google-oauth
# ===================
# Google OAuth (Optional)
# ===================
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# @end google-oauth

# @feature github-oauth
# ===================
# GitHub OAuth (Optional)
# ===================
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# @end github-oauth

# @feature turnstile
# ===================
# Bot Protection (Optional)
# ===================
# Cloudflare Turnstile: https://dash.cloudflare.com/turnstile
# Site key goes in packages/config/src/index.ts (public)
# Secret key goes here (server-side only)
TURNSTILE_SECRET_KEY=
# @end turnstile

# @feature payments
# ===================
# Payments - Polar.sh (Optional)
# ===================
# Get Access Token from: polar.sh → Settings → Developers
POLAR_ACCESS_TOKEN=
# Get Webhook Secret from: polar.sh → Settings → Webhooks
# Create webhook pointing to: https://yourdomain.com/api/payments/webhooks
POLAR_WEBHOOK_SECRET=
# @end payments
