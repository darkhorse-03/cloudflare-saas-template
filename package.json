{
  "name": "zynth-template",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=./apps/*",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check-types": "turbo run check-types",
    "preview": "turbo run preview --filter=./apps/*",
    "deploy": "turbo run deploy --filter=./apps/*",
    "destroy": "turbo run destroy",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@cloudflare/workers-types": "^4.20251225.0",
    "lefthook": "^2.0.13",
    "turbo": "^2.7.2",
    "typescript": "5.9.3",
    "ultracite": "6.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "alchemy": "^0.82.1",
    "lucide-react": "^0.562.0"
  }
}
