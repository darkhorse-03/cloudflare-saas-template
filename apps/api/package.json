{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hc": "./src/hc.ts",
    "./alchemy": {
      "bun": "./alchemy.run.ts",
      "import": "./alchemy.run.ts",
      "types": "./alchemy.run.ts"
    }
  },
  "scripts": {
    "dev": "bun run scripts/alchemy-dev.ts",
    "preview": "bun run scripts/alchemy-preview.ts",
    "deploy": "bun run scripts/alchemy-deploy.ts",
    "destroy": "bun run scripts/alchemy-destroy.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "check-types": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
