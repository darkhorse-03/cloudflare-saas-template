    "@react-email/components": "^1.0.2",
    "@repo/config": "*",
    "@repo/shared": "*",
    "alchemy": "^0.82.1",
    "better-auth": "^1.4.8",
    "better-auth-cloudflare": "^0.2.9",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251223.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^12.5.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3"
